generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum ProspectStatus {
  INTERESTED
  NOT_INTERESTED
  FOLLOW_UP
}

/// Types a tenant can choose when defining a custom prospect field.
enum FieldType {
  TEXT
  NUMBER
  SELECT // tenant-defined option list
  DATE
  BOOLEAN
  GEO // {lat,lng,accuracy} captured from the browser
  IMAGE // url to an uploaded photo (object storage)
}

/// A tenant. Every other record belongs to exactly one Organization.
model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  onboarded Boolean  @default(false) // has the hierarchy wizard been completed?
  createdAt DateTime @default(now())

  levels    Level[]
  users     User[]
  prospects Prospect[]
  logs      ActivityLog[]
  fields    FieldDefinition[]
}

/// A tenant-defined custom field on the Prospect form. Values live in
/// `Prospect.customFields` (JSON) keyed by `key`; this model is the schema.
model FieldDefinition {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  orgId     String       @db.ObjectId
  org       Organization @relation(fields: [orgId], references: [id])
  key       String // stable machine name, e.g. "next_follow_up"
  label     String // human label shown on the form
  type      FieldType
  options   String[] // choices for SELECT, empty otherwise
  required  Boolean      @default(false)
  order     Int          @default(0) // display order on the form
  createdAt DateTime     @default(now())

  @@unique([orgId, key])
  @@index([orgId])
}

/// A customer-named tier in an org's hierarchy. Replaces the old fixed Role enum.
/// `rank` orders levels: 1 = leaf (most junior) … N = top (most senior).
model Level {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  orgId   String  @db.ObjectId
  org     Organization @relation(fields: [orgId], references: [id])
  name    String  // e.g. "Founder", "Regional Head", "Agent"
  rank    Int
  seesAll Boolean @default(false) // top level(s) see the whole org

  users   User[]

  @@unique([orgId, rank])
  @@index([orgId])
}

model User {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId     String
  name           String
  email          String         @unique
  phone          String
  passwordHash   String
  status         EmployeeStatus @default(ACTIVE)
  joiningDate    DateTime       @default(now())

  organizationId String         @db.ObjectId
  organization   Organization   @relation(fields: [organizationId], references: [id])

  levelId        String         @db.ObjectId
  level          Level          @relation(fields: [levelId], references: [id])

  managerId      String?        @db.ObjectId
  manager        User?          @relation("Hierarchy", fields: [managerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  reports        User[]         @relation("Hierarchy")

  // Materialized path: ids of every ancestor up to the root.
  // Subtree queries become a single indexed `ancestorIds has <id>` filter.
  ancestorIds    String[]       @db.ObjectId

  city           String?
  state          String?
  avatarSeed     String?

  prospects      Prospect[]
  activityLogs   ActivityLog[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([organizationId, employeeId])
  @@index([organizationId])
  @@index([managerId])
  @@index([ancestorIds])
  @@index([levelId])
}

model Prospect {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String         @db.ObjectId
  organization   Organization   @relation(fields: [organizationId], references: [id])

  customerName   String
  phone          String
  address        String
  city           String
  state          String
  visitDate      DateTime
  status         ProspectStatus @default(FOLLOW_UP)
  remarks        String?

  // Tenant-defined custom field values, keyed by FieldDefinition.key.
  customFields   Json?

  collectedById  String         @db.ObjectId
  collectedBy    User           @relation(fields: [collectedById], references: [id])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, visitDate])
  @@index([collectedById, visitDate])
  @@index([status])
}

model ActivityLog {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String       @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id])

  actorId        String       @db.ObjectId
  actor          User         @relation(fields: [actorId], references: [id])
  action         String
  targetType     String
  targetId       String?      @db.ObjectId
  summary        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
}
