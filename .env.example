# MongoDB Atlas connection string (Prisma's MongoDB connector requires a replica set — Atlas free tier works).
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vk_staff?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/vk_staff?retryWrites=true&w=majority"

# Secret used to sign session JWTs. Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"

# Google sign-in (optional). Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add
# http://localhost:3000/api/auth/google/callback as an authorized redirect URI.
# The Google account's email must match an existing employee's email.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
